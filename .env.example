# Gnani speech (STT + TTS): https://app.gnani.ai/voice -> API Keys
GNANI_API_KEY=

# Agent LLM. Default: free Gemini key from https://aistudio.google.com/apikey via its OpenAI-compatible endpoint.
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Optional seconds between LLM calls if a free tier returns 429s (the SDK already retries them).
LLM_MIN_SECONDS=0
# Alternative: LLM_PROVIDER=anthropic, LLM_MODEL=claude-haiku-5-5, ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=

# Folder of the extracted capstone dataset (kb/, data/, tools/)
DATASET_DIR=./Capstone_Project_Dataset_FTTT_2026
